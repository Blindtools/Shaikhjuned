# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to GitHub - it's already in .gitignore.

# OpenRouter - free tier, NO credit card required (unlike Google Gemini,
# which now forces a billing/prepay setup for new AI Studio accounts).
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional - override the default free models if OpenRouter retires one.
# Check https://openrouter.ai/models?max_price=0 for current free options.
# OPENROUTER_TEXT_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Your own WhatsApp number (digits only, no +, e.g. 919876543210).
# Only this number can use /broadcast <message> to message every user at once.
ADMIN_NUMBER=
